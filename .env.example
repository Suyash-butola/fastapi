# Copy this file to .env and fill in your local PostgreSQL password.
DATABASE_HOSTNAME=localhost
DATABASE_PORT=5432
DATABASE_NAME=fastapi
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your-postgres-password
# Render supplies DATABASE_URL automatically. When set, it overrides the fields above.
# DATABASE_URL=postgresql://username:password@hostname:5432/fastapi
# Generate a value with: uv run python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# JSON list of frontend origins, without trailing slashes.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]
